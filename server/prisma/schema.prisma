generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  CREDIT
}

enum PaymentStatus {
  COMPLETED
  PARTIALLY_PAID
  REFUNDED
  PENDING
}

enum PurchaseStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum InventoryChangeType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum UnitCategory {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
}

enum AssetStatus {
  ACTIVE
  IN_REPAIR
  DISPOSED
  DEPRECIATED
}

enum OwnerTxType {
  CONTRIBUTION
  WITHDRAWAL
}

model User {
  id                    String    @id @default(uuid())
  username              String    @unique
  email                 String    @unique
  password_hash         String
  full_name             String
  role                  Role      @default(CASHIER)
  is_active             Boolean   @default(true)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  sales              Sale[]
  inventory_logs     InventoryLog[]
  auth_logs          AuthLog[]
  customer_payments  CustomerPayment[]
  purchases          Purchase[]
  supplier_payments  SupplierPayment[]
  expenses           Expense[]
  owner_transactions OwnerTransaction[]
  stock_adjustments  StockAdjustment[]
  sales_returns      SalesReturn[]
  purchase_returns   PurchaseReturn[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]
}

model Product {
  id                  String       @id @default(uuid())
  name                String
  sku                 String       @unique
  barcode             String?      @unique
  category_id         String?
  brand_id            String?
  unit_category       UnitCategory @default(COUNT)
  base_unit           String       @default("pcs")
  pricing_unit        String       @default("pcs")
  price               Decimal      @db.Decimal(10, 2)
  usual_price         Decimal      @default(0) @db.Decimal(10, 2)
  our_price           Decimal      @default(0) @db.Decimal(10, 2)
  wholesale_price     Decimal      @default(0) @db.Decimal(10, 2)
  cost_price          Decimal?     @db.Decimal(10, 2)
  quantity            Decimal      @default(0) @db.Decimal(14, 3)
  low_stock_threshold Decimal      @default(10) @db.Decimal(14, 3)
  image_url           String?
  is_active           Boolean      @default(true)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  category               Category?             @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brand                  Brand?                @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  sale_items             SaleItem[]
  inventory_logs         InventoryLog[]
  purchase_items         PurchaseItem[]
  stock_adjustment_items StockAdjustmentItem[]
  sales_return_items     SalesReturnItem[]
  purchase_return_items  PurchaseReturnItem[]

  @@index([barcode])
  @@index([sku])
  @@index([brand_id])
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?  @unique
  address        String?
  loyalty_points Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  sales             Sale[]
  customer_payments CustomerPayment[]
  sales_returns     SalesReturn[]

  @@index([phone])
}

model Sale {
  id                    String        @id @default(uuid())
  transaction_id        String        @unique
  user_id               String
  customer_id           String?
  warehouse_id          String?
  subtotal              Decimal       @db.Decimal(10, 2)
  discount_amount       Decimal       @default(0) @db.Decimal(10, 2)
  tax_amount            Decimal       @default(0) @db.Decimal(10, 2)
  total_amount          Decimal       @db.Decimal(10, 2)
  amount_paid           Decimal       @default(0) @db.Decimal(10, 2)
  balance_due           Decimal       @default(0) @db.Decimal(10, 2)
  payment_method        PaymentMethod
  payment_status        PaymentStatus @default(COMPLETED)
  notes                 String?
  sale_date             DateTime?
  is_legacy_import      Boolean       @default(false)
  is_cancelled          Boolean       @default(false)
  cancelled_at          DateTime?
  cancelled_by          String?
  cancellation_reason   String?
  // Points awarded by this sale; a refund reverses exactly this many
  loyalty_points_earned Int           @default(0)
  // Set while a Paystack refund is awaiting confirmation by webhook
  refund_requested_at   DateTime?
  refund_requested_by   String?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  user                         User                        @relation(fields: [user_id], references: [id])
  customer                     Customer?                   @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  warehouse                    Warehouse?                  @relation(fields: [warehouse_id], references: [id])
  sale_items                   SaleItem[]
  payments                     Payment[]
  paystack_payment             PaystackPayment?
  customer_payment_allocations CustomerPaymentAllocation[]
  sales_returns                SalesReturn[]

  @@index([transaction_id])
  @@index([created_at])
  @@index([sale_date])
  @@index([warehouse_id])
}

model SaleItem {
  id                          String   @id @default(uuid())
  sale_id                     String
  product_id                  String
  product_name                String   @default("")
  product_sku                 String   @default("")
  unit                        String   @default("pcs")
  quantity                    Decimal  @db.Decimal(10, 3)
  base_quantity               Decimal  @default(1) @db.Decimal(14, 3)
  base_unit                   String   @default("pcs")
  pricing_unit                String   @default("pcs")
  unit_price                  Decimal  @db.Decimal(10, 2)
  unit_cost_snapshot          Decimal  @default(0) @db.Decimal(10, 2)
  cost_price_snapshot         Decimal? @db.Decimal(10, 2)
  usual_price_snapshot        Decimal  @default(0) @db.Decimal(10, 2)
  our_price_snapshot          Decimal  @default(0) @db.Decimal(10, 2)
  predefined_discount_applied Boolean  @default(false)
  predefined_discount_amount  Decimal  @default(0) @db.Decimal(10, 2)
  is_wholesale                Boolean  @default(false)
  wholesale_price_snapshot    Decimal  @default(0) @db.Decimal(10, 2)
  line_cost                   Decimal  @default(0) @db.Decimal(10, 2)
  discount                    Decimal  @default(0) @db.Decimal(10, 2)
  total                       Decimal  @db.Decimal(10, 2)
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  sale               Sale              @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [product_id], references: [id], onDelete: Restrict)
  sales_return_items SalesReturnItem[]

  @@index([sale_id])
  @@index([product_id])
}

model Payment {
  id           String        @id @default(uuid())
  sale_id      String
  method       PaymentMethod
  amount_paid  Decimal       @db.Decimal(10, 2)
  change_given Decimal       @default(0) @db.Decimal(10, 2)
  reference    String?       @unique
  is_void      Boolean       @default(false)
  void_reason  String?
  voided_at    DateTime?
  voided_by    String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)
}

model CustomerPayment {
  id             String        @id @default(uuid())
  customer_id    String
  user_id        String
  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  is_void        Boolean       @default(false)
  void_reason    String?
  voided_at      DateTime?
  voided_by      String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  customer    Customer                    @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [user_id], references: [id])
  allocations CustomerPaymentAllocation[]

  @@index([customer_id])
  @@index([created_at])
}

model CustomerPaymentAllocation {
  id                  String   @id @default(uuid())
  customer_payment_id String
  sale_id             String
  amount              Decimal  @db.Decimal(10, 2)
  created_at          DateTime @default(now())

  customer_payment CustomerPayment @relation(fields: [customer_payment_id], references: [id], onDelete: Cascade)
  sale             Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([customer_payment_id])
  @@index([sale_id])
}

model InventoryLog {
  id                String              @id @default(uuid())
  product_id        String
  change_type       InventoryChangeType
  unit              String              @default("pcs")
  quantity_change   Decimal             @db.Decimal(14, 3)
  previous_quantity Decimal             @db.Decimal(14, 3)
  new_quantity      Decimal             @db.Decimal(14, 3)
  user_id           String
  warehouse_id      String?
  notes             String?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  product   Product    @relation(fields: [product_id], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [user_id], references: [id])
  warehouse Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@index([warehouse_id])
}

model AuthLog {
  id         String   @id @default(uuid())
  user_id    String?
  event_type String
  ip_address String?
  user_agent String?
  details    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Settings {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// A successful Paystack charge reported by the charge.success webhook.
// sale_id stays null if the POS never created a sale for it (e.g. the
// browser closed after paying); managers then see it as unmatched.
model PaystackPayment {
  id                  String    @id @default(uuid())
  reference           String    @unique
  amount              Int // pesewas
  currency            String
  channel             String?
  customer_email      String?
  paid_at             DateTime?
  sale_id             String?   @unique
  refund_requested_at DateTime?
  refunded_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  sale Sale? @relation(fields: [sale_id], references: [id], onDelete: SetNull)
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  contact_person String?
  notes          String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  purchases         Purchase[]
  supplier_payments SupplierPayment[]
  purchase_returns  PurchaseReturn[]

  @@index([name])
  @@index([phone])
}

model Purchase {
  id               String         @id @default(uuid())
  purchase_number  String         @unique
  supplier_id      String
  user_id          String
  warehouse_id     String?
  status           PurchaseStatus @default(ORDERED)
  payment_status   PaymentStatus  @default(PENDING)
  subtotal         Decimal        @default(0) @db.Decimal(10, 2)
  tax_amount       Decimal        @default(0) @db.Decimal(10, 2)
  total_amount     Decimal        @db.Decimal(10, 2)
  amount_paid      Decimal        @default(0) @db.Decimal(10, 2)
  balance_due      Decimal        @default(0) @db.Decimal(10, 2)
  received_at      DateTime?
  notes            String?
  purchase_date    DateTime?
  is_legacy_import Boolean        @default(false)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  supplier    Supplier                    @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  user        User                        @relation(fields: [user_id], references: [id])
  warehouse        Warehouse?                  @relation(fields: [warehouse_id], references: [id])
  items            PurchaseItem[]
  allocations      SupplierPaymentAllocation[]
  purchase_returns PurchaseReturn[]

  @@index([purchase_number])
  @@index([supplier_id])
  @@index([created_at])
  @@index([purchase_date])
  @@index([warehouse_id])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchase_id   String
  product_id    String
  product_name  String   @default("")
  product_sku   String   @default("")
  unit          String   @default("pcs")
  quantity      Decimal  @db.Decimal(10, 3)
  base_quantity Decimal  @default(1) @db.Decimal(14, 3)
  unit_cost     Decimal  @db.Decimal(10, 2)
  total_cost    Decimal  @db.Decimal(10, 2)
  created_at    DateTime @default(now())

  purchase               Purchase             @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product                Product              @relation(fields: [product_id], references: [id], onDelete: Restrict)
  purchase_return_items  PurchaseReturnItem[]

  @@index([purchase_id])
  @@index([product_id])
}

model SupplierPayment {
  id             String        @id @default(uuid())
  supplier_id    String
  user_id        String
  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  supplier    Supplier                    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [user_id], references: [id])
  allocations SupplierPaymentAllocation[]

  @@index([supplier_id])
  @@index([created_at])
}

model SupplierPaymentAllocation {
  id                  String   @id @default(uuid())
  supplier_payment_id String
  purchase_id         String
  amount              Decimal  @db.Decimal(10, 2)
  created_at          DateTime @default(now())

  supplier_payment SupplierPayment @relation(fields: [supplier_payment_id], references: [id], onDelete: Cascade)
  purchase         Purchase        @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([supplier_payment_id])
  @@index([purchase_id])
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  expenses Expense[]
}

model Expense {
  id               String        @id @default(uuid())
  category_id      String
  user_id          String
  amount           Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod @default(CASH)
  expense_date     DateTime      @default(now())
  payee            String?
  reference        String?
  notes            String?
  is_legacy_import Boolean       @default(false)
  is_cancelled     Boolean       @default(false)
  cancelled_at     DateTime?
  cancelled_by     String?
  cancellation_reason String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  category ExpenseCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  user     User            @relation(fields: [user_id], references: [id])

  @@index([category_id])
  @@index([expense_date])
  @@index([created_at])
}

model BusinessAsset {
  id               String      @id @default(uuid())
  name             String
  asset_code       String?     @unique
  category         String // Equipment, Vehicle, Electronics/Computers, Furniture & Fixture, Building/Leasehold
  acquisition_cost Decimal     @db.Decimal(10, 2)
  acquisition_date DateTime    @default(now())
  current_value    Decimal     @db.Decimal(10, 2)
  status           AssetStatus @default(ACTIVE)
  location         String?
  notes            String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  @@index([category])
  @@index([status])
}

model OwnerTransaction {
  id               String        @id @default(uuid())
  user_id          String
  type             OwnerTxType
  amount           Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod @default(CASH)
  transaction_date DateTime      @default(now())
  reference        String?
  notes            String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([type])
  @@index([transaction_date])
}

// ============================================================================
// Legacy POS Migration Models (Phase 2)
// ============================================================================

model LegacyIdMap {
  id            String   @id @default(uuid())
  source_system String   @default("legacy_pos")
  entity_type   String // "Sale", "Purchase", "Product", "Customer", "Supplier", "Expense", etc.
  legacy_id     String // Preserved as string per Step 3
  target_model  String // Target Prisma model name
  nextill_id    String // Target NexTill UUID
  batch_id      String? // Optional migration batch
  metadata      Json? // Safe diagnostic metadata (no credentials)
  created_at    DateTime @default(now())

  batch MigrationBatch? @relation(fields: [batch_id], references: [id])

  @@unique([source_system, entity_type, legacy_id])
  @@index([entity_type, nextill_id])
  @@index([target_model, nextill_id])
  @@index([batch_id])
}

model MigrationBatch {
  id            String    @id @default(uuid())
  batch_number  Int       @unique @default(autoincrement())
  source_file   String? // e.g., "POS_Complete_Export_v4.xlsx"
  source_sha256 String?
  entity_type   String // Which entity type this batch imported
  record_count  Int       @default(0)
  success_count Int       @default(0)
  error_count   Int       @default(0)
  status        String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, ROLLED_BACK
  started_at    DateTime?
  completed_at  DateTime?
  rollback_at   DateTime?
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  legacy_id_maps LegacyIdMap[]
  issues         MigrationIssue[]

  @@index([entity_type])
  @@index([status])
}

model MigrationIssue {
  id                String    @id @default(uuid())
  batch_id          String?
  entity_type       String
  legacy_id         String?
  issue_code        String?
  severity          String // ERROR, WARNING, INFO
  description       String
  resolution_status String    @default("UNRESOLVED")
  resolution        String?
  resolved_at       DateTime?
  metadata          Json? // Safe diagnostic metadata (no credentials)
  created_at        DateTime  @default(now())

  batch MigrationBatch? @relation(fields: [batch_id], references: [id])

  @@index([batch_id])
  @@index([entity_type, legacy_id])
  @@index([severity])
  @@index([issue_code])
}

model Warehouse {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String   @unique
  address    String?
  is_active  Boolean  @default(true)
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sales             Sale[]
  purchases         Purchase[]
  stock_adjustments StockAdjustment[]
  inventory_logs    InventoryLog[]
  sales_returns     SalesReturn[]
  purchase_returns  PurchaseReturn[]

  @@index([is_default])
}

model StockAdjustment {
  id                String   @id @default(uuid())
  adjustment_number String?  @unique
  adjustment_date   DateTime
  warehouse_id      String?
  user_id           String
  reason            String?
  notes             String?
  is_legacy_import  Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user      User                  @relation(fields: [user_id], references: [id])
  warehouse Warehouse?            @relation(fields: [warehouse_id], references: [id])
  items     StockAdjustmentItem[]

  @@index([adjustment_date])
  @@index([warehouse_id])
}

model StockAdjustmentItem {
  id              String   @id @default(uuid())
  adjustment_id   String
  product_id      String? // Optional product mapping
  quantity_change Decimal  @db.Decimal(14, 3)
  method_type     Int? // Raw unresolved legacy method code
  unit            String   @default("pcs")
  notes           String?
  created_at      DateTime @default(now())

  adjustment StockAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([adjustment_id])
  @@index([product_id])
}

model SalesReturn {
  id               String        @id @default(uuid())
  return_number    String        @unique
  sale_id          String
  customer_id      String?
  user_id          String
  warehouse_id     String?
  return_date      DateTime      @default(now())
  reason           String
  refund_status    String        @default("COMPLETED") // COMPLETED, PENDING, FAILED
  refund_method    PaymentMethod @default(CASH)
  refund_amount    Decimal       @db.Decimal(10, 2)
  notes            String?
  idempotency_key  String?       @unique
  is_legacy_import Boolean       @default(false)
  is_cancelled     Boolean       @default(false)
  cancelled_at     DateTime?
  cancelled_by     String?
  cancellation_reason String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  sale      Sale              @relation(fields: [sale_id], references: [id], onDelete: Restrict)
  customer  Customer?         @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  user      User              @relation(fields: [user_id], references: [id])
  warehouse Warehouse?        @relation(fields: [warehouse_id], references: [id])
  items     SalesReturnItem[]

  @@index([sale_id])
  @@index([customer_id])
  @@index([return_date])
  @@index([warehouse_id])
}

model SalesReturnItem {
  id              String   @id @default(uuid())
  sales_return_id String
  sale_item_id    String
  product_id      String
  product_name    String   @default("")
  product_sku     String   @default("")
  unit            String   @default("pcs")
  quantity        Decimal  @db.Decimal(10, 3)
  base_quantity   Decimal  @default(1) @db.Decimal(14, 3)
  unit_price      Decimal  @db.Decimal(10, 2)
  refund_subtotal Decimal  @db.Decimal(10, 2)
  restock         Boolean  @default(true)
  disposition     String   @default("RESTOCKED") // RESTOCKED, DAMAGED, DISCARDED
  created_at      DateTime @default(now())

  sales_return SalesReturn @relation(fields: [sales_return_id], references: [id], onDelete: Cascade)
  sale_item    SaleItem    @relation(fields: [sale_item_id], references: [id], onDelete: Restrict)
  product      Product     @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([sales_return_id])
  @@index([sale_item_id])
  @@index([product_id])
}

model PurchaseReturn {
  id                String        @id @default(uuid())
  return_number     String        @unique
  purchase_id       String
  supplier_id       String
  user_id           String
  warehouse_id      String?
  return_date       DateTime      @default(now())
  reason            String
  settlement_status String        @default("PENDING") // PENDING, COMPLETED, CREDITED
  settlement_method PaymentMethod @default(CASH)
  total_amount      Decimal       @db.Decimal(10, 2)
  notes             String?
  idempotency_key   String?       @unique
  is_legacy_import  Boolean       @default(false)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  purchase  Purchase             @relation(fields: [purchase_id], references: [id], onDelete: Restrict)
  supplier  Supplier             @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  user      User                 @relation(fields: [user_id], references: [id])
  warehouse Warehouse?           @relation(fields: [warehouse_id], references: [id])
  items     PurchaseReturnItem[]

  @@index([purchase_id])
  @@index([supplier_id])
  @@index([return_date])
  @@index([warehouse_id])
}

model PurchaseReturnItem {
  id                 String   @id @default(uuid())
  purchase_return_id String
  purchase_item_id   String
  product_id         String
  product_name       String   @default("")
  product_sku        String   @default("")
  unit               String   @default("pcs")
  quantity           Decimal  @db.Decimal(10, 3)
  base_quantity      Decimal  @default(1) @db.Decimal(14, 3)
  unit_cost          Decimal  @db.Decimal(10, 2)
  total_cost         Decimal  @db.Decimal(10, 2)
  created_at         DateTime @default(now())

  purchase_return PurchaseReturn @relation(fields: [purchase_return_id], references: [id], onDelete: Cascade)
  purchase_item   PurchaseItem   @relation(fields: [purchase_item_id], references: [id], onDelete: Restrict)
  product         Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([purchase_return_id])
  @@index([purchase_item_id])
  @@index([product_id])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]
}

model Variation {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  values VariationValue[]
}

model VariationValue {
  id           String   @id @default(uuid())
  variation_id String
  value        String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  variation Variation @relation(fields: [variation_id], references: [id], onDelete: Cascade)

  @@unique([variation_id, value])
  @@index([variation_id])
}
